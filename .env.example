# ==============================================================================
# GRANTLY — Environment Variables Template
# ==============================================================================
# IMPORTANT SECURITY GUIDELINE:
# - NEVER commit production secrets, private keys, or credentials to git.
# - Copy this file to '.env.local' for local development configuration.
# - Production builds on Vercel should use the Vercel Dashboard Environment Variables.
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Base Application URL
VITE_APP_URL=http://localhost:5173

# Optional: Originkit Component Licensing API Key (Client Component)
# Leave blank or insert your personal Originkit key for CLI additions
# VITE_ORIGINKIT_API_KEY=your_originkit_api_key_here

# Telemetry / Analytics toggle (Defaults to disabled for student privacy)
VITE_ENABLE_ANALYTICS=false
